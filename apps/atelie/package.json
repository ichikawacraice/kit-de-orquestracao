{
  "name": "@wicomm/atelie",
  "version": "0.1.0",
  "description": "O ateliê da Wicomm: o catálogo vivo das peças do registro, nos dois temas, e o próprio registro servido em /r/v{versao}/.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/registro.mjs && next dev",
    "build": "node scripts/registro.mjs && next build && node scripts/conferir-saida.mjs",
    "test": "vitest run && tsc --noEmit -p . && wicomm-guardas && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@wicomm/guardas": "*",
    "@wicomm/registro": "*",
    "@wicomm/tokens": "*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
