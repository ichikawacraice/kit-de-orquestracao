    "modal-abre": "220ms",
    "modal-fecha": "140ms",
    "menu-abre": "160ms",
    "menu-fecha": "110ms",
    "dica": "120ms",
    "painel": "200ms",
    "dobra-abre": "200ms",
    "dobra-fecha": "150ms",
    "cor": "150ms",
    "revela": "150ms"
  },
  "atrasos": {
    "veu": "120ms",
    "espiada-abre": "250ms",
    "espiada-fecha": "300ms"
  },
  "curvas": {
    "abre": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fecha": "cubic-bezier(0.4, 0, 1, 1)"
