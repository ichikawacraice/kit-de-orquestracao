      "font-stretch": "106%",
      "letter-spacing": "-.024em",
      "line-height": "1.15"
    },
    "t-titulo": {
      "font-size": "15px",
      "font-weight": "600",
      "letter-spacing": "-.014em",
      "line-height": "1.3"
    },
    "t-denso": {
      "font-size": "12px",
      "font-weight": "400"
    },
    "t-rotulo": {
      "font-size": "10.5px",
      "font-weight": "700",
      "font-stretch": "80%",
      "letter-spacing": ".13em",
      "text-transform": "uppercase",
      "color": "var(--foreground-2)"
    },
    "t-coluna": {
      "font-size": "10.5px",
      "font-weight": "500",
      "letter-spacing": ".08em",
      "text-transform": "uppercase",
      "color": "var(--foreground-2)"
    },
    "t-campo": {
      "font-size": "13px",
      "font-weight": "500",
      "line-height": "1.35",
      "letter-spacing": "normal",
      "text-transform": "none",
      "font-stretch": "100%",
      "color": "var(--foreground)"
    },
    "t-medida": {
      "font-family": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
      "font-size": "12px",
      "font-variant-numeric": "tabular-nums",
      "letter-spacing": "-.02em"
    }
  },
