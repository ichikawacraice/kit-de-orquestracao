      "css": {
        "@import \"tw-animate-css\"": {},
        ":root": {
          "color-scheme": "light",
          "--primary-gradient": "linear-gradient(118deg, var(--primary-gradient-start) 0%, var(--primary-gradient-mid) 46%, var(--primary-gradient-end) 100%)",
          "--ia-gradient": "linear-gradient(110deg, var(--ia-violeta) 0%, var(--ia-azul) 50%, var(--ia-violeta) 100%)",
          "--sombra-painel": "0 0 0 1px rgba(19,23,34,.05), 0 1px 2px rgba(19,23,34,.04), 0 8px 26px -14px rgba(19,23,34,.10)",
          "--superficie-sombra": "0 0 0 1px rgba(19,23,34,.05), 0 1px 2px rgba(19,23,34,.05), 0 5px 14px -6px rgba(19,23,34,.09)",
          "--superficie-sombra-alta": "0 0 0 1px rgba(19,23,34,.07), 0 2px 5px rgba(19,23,34,.07), 0 12px 26px -10px rgba(19,23,34,.15)",
          "--superficie-sombra-flutuante": "0 0 0 1px rgba(19,23,34,.08), 0 24px 56px -16px rgba(19,23,34,.26), 0 4px 12px -4px rgba(19,23,34,.12)",
          "--raio-cartao": "14px",
          "--raio-painel": "16px",
          "--raio-ctrl": "7px",
          "--raio-badge": "6px",
          "--raio-marcacao": "5px"
        },
        ".dark": {
          "color-scheme": "dark",
          "--primary-gradient": "linear-gradient(118deg, var(--primary-gradient-start) 0%, var(--primary-gradient-mid) 46%, var(--primary-gradient-end) 100%)",
          "--ia-gradient": "linear-gradient(110deg, var(--ia-violeta) 0%, var(--ia-azul) 50%, var(--ia-violeta) 100%)",
          "--sombra-painel": "0 0 0 1px rgba(255,255,255,.05), 0 1px 2px rgba(0,0,0,.4), 0 10px 30px -16px rgba(0,0,0,.55)",
          "--superficie-sombra": "0 0 0 1px rgba(255,255,255,.055), 0 1px 2px rgba(0,0,0,.4), 0 5px 14px -6px rgba(0,0,0,.5)",
          "--superficie-sombra-alta": "0 0 0 1px rgba(255,255,255,.09), 0 2px 6px rgba(0,0,0,.5), 0 12px 28px -10px rgba(0,0,0,.6)",
          "--superficie-sombra-flutuante": "0 0 0 1px rgba(255,255,255,.1), 0 26px 60px -16px rgba(0,0,0,.75), 0 4px 12px -4px rgba(0,0,0,.5)"
        },
        "@keyframes accordion-down": {
          "from": {
            "height": "0"
          },
          "to": {
            "height": "var(--radix-accordion-content-height)"
          }
        },
        "@keyframes accordion-up": {
          "from": {
            "height": "var(--radix-accordion-content-height)"
          },
          "to": {
            "height": "0"
          }
        },
        "@layer base": {
          "*, ::after, ::before, ::backdrop, ::file-selector-button": {
            "border-color": "var(--border)"
          },
          "body": {
            "background-color": "var(--background)",
            "color": "var(--foreground)"
          }
        },
        "@utility duration-modal-abre": {
          "--tw-duration": "220ms",
          "transition-duration": "220ms"
        },
        "@utility duration-modal-fecha": {
          "--tw-duration": "140ms",
          "transition-duration": "140ms"
        },
        "@utility duration-menu-abre": {
          "--tw-duration": "160ms",
          "transition-duration": "160ms"
        },
        "@utility duration-menu-fecha": {
          "--tw-duration": "110ms",
          "transition-duration": "110ms"
        },
        "@utility duration-dica": {
          "--tw-duration": "120ms",
          "transition-duration": "120ms"
        },
        "@utility duration-painel": {
          "--tw-duration": "200ms",
          "transition-duration": "200ms"
        },
        "@utility duration-dobra-abre": {
          "--tw-duration": "200ms",
          "transition-duration": "200ms"
        },
        "@utility duration-dobra-fecha": {
          "--tw-duration": "150ms",
          "transition-duration": "150ms"
        },
        "@utility duration-cor": {
          "--tw-duration": "150ms",
          "transition-duration": "150ms"
        },
        "@utility duration-revela": {
          "--tw-duration": "150ms",
          "transition-duration": "150ms"
        },
        "@utility delay-veu": {
          "transition-delay": "120ms",
          "--tw-animation-delay": "120ms",
          "animation-delay": "120ms"
        },
        "@utility delay-espiada-abre": {
          "transition-delay": "250ms",
          "--tw-animation-delay": "250ms",
          "animation-delay": "250ms"
        },
        "@utility delay-espiada-fecha": {
          "transition-delay": "300ms",
          "--tw-animation-delay": "300ms",
          "animation-delay": "300ms"
        },
        "@utility font-archivo": {
          "font-family": "var(--font-archivo), sans-serif"
        },
        "@utility h-ctrl": {
          "height": "30px"
        },
        "@utility size-ctrl": {
          "width": "30px",
          "height": "30px"
        },
        "@utility superficie": {
          "background-color": "var(--card)",
          "box-shadow": "var(--superficie-sombra)"
        },
        "@utility superficie-alta": {
          "background-color": "var(--card)",
          "box-shadow": "var(--superficie-sombra-alta)"
        },
        "@utility superficie-flutuante": {
          "background-color": "var(--popover)",
          "box-shadow": "var(--superficie-sombra-flutuante)"
        },
        "@utility anel-de-controle": {
          "box-shadow": "inset 0 0 0 1px var(--input)"
        },
        "@utility bg-primary-gradient": {
          "background-image": "var(--primary-gradient)",
          "background-color": "var(--primary)"
        },
        "@layer components": {
          ".t-display": {
            "font-size": "23px",
            "font-weight": "600",
            "font-stretch": "106%",
            "letter-spacing": "-.024em",
            "line-height": "1.15"
          },
          ".t-titulo": {
            "font-size": "15px",
            "font-weight": "600",
            "letter-spacing": "-.014em",
            "line-height": "1.3"
          },
          ".t-denso": {
            "font-size": "12px",
            "font-weight": "400"
          },
          ".t-rotulo": {
            "font-size": "10.5px",
            "font-weight": "700",
            "font-stretch": "80%",
            "letter-spacing": ".13em",
            "text-transform": "uppercase",
            "color": "var(--foreground-2)"
          },
          ".t-coluna": {
            "font-size": "10.5px",
            "font-weight": "500",
            "letter-spacing": ".08em",
            "text-transform": "uppercase",
            "color": "var(--foreground-2)"
          },
          ".t-campo": {
            "font-size": "13px",
            "font-weight": "500",
            "line-height": "1.35",
            "letter-spacing": "normal",
            "text-transform": "none",
            "font-stretch": "100%",
            "color": "var(--foreground)"
          },
          ".t-medida": {
            "font-family": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
            "font-size": "12px",
            "font-variant-numeric": "tabular-nums",
            "letter-spacing": "-.02em"
          },
          ".painel": {
            "background-color": "var(--card)",
            "border-radius": "var(--raio-painel)",
            "box-shadow": "var(--sombra-painel)"
          }
        }
      }
    },
