{
  "manifestVersion": 2,
  "id": "painel-do-kit",
  "name": "Kit de orquestração",
  "version": "0.1.0",
  "description": "Perguntas abertas, decisões assumidas e entregas das sessões do kit de orquestração, sem gastar modelo para ler.",
  "engines": { "orca": ">=1.4.248" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      { "id": "kit", "title": "Kit", "icon": "bell", "entry": "src/panel.tsx", "ui": "components" }
    ],
    "statusBarItems": [
      { "id": "kit", "text": "Kit: …", "icon": "bell", "tooltip": "Perguntas e decisões do kit de orquestração" }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "notifications:show" },
    { "kind": "workspace:read" },
    { "kind": "terminal:send" }
  ]
}
