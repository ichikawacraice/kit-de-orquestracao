{
  "name": "kit-de-orquestracao",
  "version": "0.2.0",
  "description": "Kit de orquestração de sessões Claude e Codex na ORCA: uma sessão dona por item, travas por hook, painel, fila de merge e teto de testes.",
  "private": true,
  "type": "module",
  "bin": { "kit": "cli/kit.mjs" },
  "engines": { "node": ">=20" },
  "scripts": { "test": "node gate/com-fichas.mjs --quero 4 -- node --test --test-concurrency={fichas} '{cli,gate,modelos,orca,plugins,scripts,test}/**/*.test.{cjs,mjs,js}' '{cli,gate,modelos,orca,plugins,scripts,test}/**/test/**/*.{cjs,mjs,js}' 'test/**/*.{cjs,mjs,js}'" },
  "license": "MIT"
}
